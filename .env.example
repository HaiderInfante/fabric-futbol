# Plantilla de variables de entorno.
# Copia este archivo como .env (que está en .gitignore) y completa los valores.
# Nunca subas .env al repositorio ni pegues las keys en issues, PRs o chats.

# --- football-data.org (plan gratuito: 10 llamadas/min) ---
# Registro: https://www.football-data.org
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# --- API-Football, registro directo en api-sports.io (plan gratuito: 100 llamadas/día) ---
# Registro: https://api-sports.io (usar la key del dashboard, no la de RapidAPI)
API_FOOTBALL_API_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# --- StatsBomb Open Data (público, no requiere key) ---
STATSBOMB_BASE_URL=https://raw.githubusercontent.com/statsbomb/open-data/master/data
